# Namen van de omgevingsvariabelen van de contact-API. GEEN waarden in de repo.
# Op de server staan ze in een env-bestand met rechten 600 (buiten de repo).
CLOUDFLARE_TURNSTILE_SECRET=
# Mailroute (advies: Google Workspace SMTP-relay, IP-allowlist, geen wachtwoord)
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Zonder aanhalingstekens: Docker Compose env_file leest een openend " als
# begin van een gequote waarde. nodemailer leest "WBIC <adres>" als naam + adres.
SMTP_FROM=WBIC <noreply@wbic.nl>
SMTP_TO=info@wbic.nl
# Alleen bij route smtp.gmail.com + app-wachtwoord (anders leeg laten):
SMTP_USER=
SMTP_PASS=
# Optioneel
SMTP_HELO_NAME=wbic.nl
TRUST_PROXY_HOPS=2
